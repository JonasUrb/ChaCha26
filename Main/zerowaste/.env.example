# .env – ZeroWaste Kitchen Bot
# Copy to .env and fill in your credentials. Never commit .env to Git!

# Academic Cloud API credentials
ACADEMIC_CLOUD_API_KEY=your_api_key_here
ACADEMIC_CLOUD_BASE_URL=https://chat-ai.academiccloud.de/v1
LLM_MODEL=qwen3-30b-a3b-instruct-2507

# Ports
API_PORT=8000    # REST API  →  http://localhost:8000
UI_PORT=8511     # Frontend  →  http://localhost:8511

# API URL injected into the frontend (change if running on a server)
API_BASE_URL=http://localhost

# Data directory for SQLite DB and conversation logs
DATA_DIR=./data
